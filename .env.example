# ==============================================================================
# Ajaia Docs — Environment Configuration
# ==============================================================================
# NOTE: ZERO environment variables are required to run this application!
# The app is fully self-contained with an embedded SQLite database and seeded
# team users. It runs out-of-the-box with `npm run dev`.
#
# All variables below are completely optional:
# ==============================================================================

# Optional: Port number for the Next.js server (Default: 3000)
PORT=3000

# Optional: Node environment (Default: development)
NODE_ENV=development

# Optional: Custom SQLite database storage path (Default: ./data/ajaia-docs.sqlite)
# DATABASE_PATH="./data/ajaia-docs.sqlite"
